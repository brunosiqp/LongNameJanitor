{
  "Urls": "http://*:5080",
  "Dashboard": {
    "AdminKey": ""
  },
  "Janitor": {
    "RescanMinutes": 5,
    "DryRun": false,
    "NfCacheDays": 30,
    "HistoryZipAfterDays": 7,
    "HistoryKeepZipDays": 365
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
